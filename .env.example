# Copy to backend/.env  (all optional; the app works with no paid API)
CLIPGENIUS_WHISPER_MODEL=tiny          # tiny | base | small
CLIPGENIUS_WHISPER_DEVICE=cpu
CLIPGENIUS_MAX_UPLOAD_MB=500
CLIPGENIUS_SILENCE_DB=-35
CLIPGENIUS_SILENCE_MIN_SECONDS=0.5
# Optional LLM prompt interpretation (JSON-only, validated by Pydantic). Leave empty to use the local parser.
CLIPGENIUS_LLM_API_KEY=
CLIPGENIUS_LLM_MODEL=gpt-4o-mini
CLIPGENIUS_LLM_BASE_URL=https://api.openai.com/v1
